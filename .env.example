# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: a model tuned for PEN-36 structured line-art planning.
GEMINI_ILLUSTRATOR_MODEL=
# PEN-36 trace path: Balanced uses the fast model; Detailed uses the premium
# model at higher resolution. Both are current stable Nano Banana models.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_DETAILED_IMAGE_MODEL=gemini-3-pro-image
# Legacy default for clients that omit quality: 1 = Detailed, 0 = Quick.
ILLUSTRATOR_TRACE=1
# Optional: a model tuned for PEN-37 language conversation and correction.
GEMINI_LANGUAGE_MODEL=
# Optional: a model tuned for PEN-38 counterargument generation.
GEMINI_DEBATE_MODEL=
# Optional: a model for PEN-39 image classification and non-math vision.
GEMINI_VISION_MODEL=
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# With DJANGO_DEBUG=true the server allows any host (LAN IP from your phone).
# Find your Mac IP: System Settings → Network, or: ipconfig getifaddr en0
