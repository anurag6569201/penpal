# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: a model tuned for PEN-36 structured line-art planning.
GEMINI_ILLUSTRATOR_MODEL=
# PEN-36 trace path: the image model the tracer renders then draws. Default is
# nano-banana; gemini-3-pro-image-preview is the higher-fidelity option.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# PEN-36 trace path on/off. 1 = generate an image and trace it (richer sketches);
# 0 = plan stroke geometry directly with no image call (the offline fallback).
ILLUSTRATOR_TRACE=1
# Optional: a model tuned for PEN-37 language conversation and correction.
GEMINI_LANGUAGE_MODEL=
# Optional: a model tuned for PEN-38 counterargument generation.
GEMINI_DEBATE_MODEL=
# Optional: a model for PEN-39 image classification and non-math vision.
GEMINI_VISION_MODEL=
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# With DJANGO_DEBUG=true the server allows any host (LAN IP from your phone).
# Find your Mac IP: System Settings → Network, or: ipconfig getifaddr en0
